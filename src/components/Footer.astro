---
import "../styles/global.css";
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
    <div
        class="
            container-content
            flex
            flex-col
            gap-4
            py-10
            text-xs
            font-600
            text-zinc-500
            dark:text-zinc-500
            sm:flex-row
            sm:items-center
            sm:justify-between
        "
    >
        <p>
            © {new Date().getFullYear()} Sylvie, Rawsie, Seia
        </p>

        <p>
            Built with <span class="text-zinc-700 dark:text-zinc-300">
                Astro, UnoCSS, React, MDX
            </span>
        </p>
    </div>
</footer>