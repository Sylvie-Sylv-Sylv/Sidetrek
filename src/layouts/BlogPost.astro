---
import "../styles/global.css";

const {
  title,
  description,
  pubDate
} = Astro.props;
---

<html lang="en">
  <head>
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
  </head>

  <body>
    <header>
      <a href="/">Your Blog</a>
    </header>

    <main>
      <article>
        <header>
          <h1>{title}</h1>

          <time>
            {pubDate.toLocaleDateString()}
          </time>
        </header>

        <slot />
      </article>
    </main>
  </body>
</html>