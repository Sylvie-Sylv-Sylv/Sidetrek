---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sylvie",
  description = "Things we've learned, built, broken, and occasionally understood.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <slot name="head" />
  </head>

  <body
    class="
      min-h-screen
      flex
      flex-col
      bg-zinc-50
      text-zinc-950
      dark:bg-zinc-950
      dark:text-zinc-50
      transition-colors
      duration-300
    "
  >
    <Navbar />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>